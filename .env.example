# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
# Never commit .env or paste keys into code.

# --- answer model ----------------------------------------------------------------------------------------------------
# evidence          : no model; answers are built from retrieved evidence only (images are not interpreted)
# openai_compatible : any OpenAI-compatible chat/completions endpoint that accepts image_url inputs
# anthropic         : Claude via the anthropic SDK (pip install anthropic; paid API)
OCT_VLM_PROVIDER=evidence

# Option A - OpenRouter (hosted). Free ":free" models are limited (about 20 requests/min, 50/day without purchased
# credits) and their availability changes: run `python -m app.check_vlm --list-only` to see the current
# image-capable free models, then set OCT_VLM_MODEL to one of them.
# OCT_VLM_PROVIDER=openai_compatible
# OCT_VLM_BASE_URL=https://openrouter.ai/api/v1
# OCT_VLM_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# OPENROUTER_API_KEY=

# Option B - Ollama (local, free, offline). Install Ollama >= 0.7, then: ollama pull qwen2.5vl:7b
# (about 6 GB; use qwen2.5vl:3b, about 3.2 GB, if GPU memory is tight). No API key needed.
# OCT_VLM_PROVIDER=openai_compatible
# OCT_VLM_BASE_URL=http://localhost:11434/v1
# OCT_VLM_MODEL=qwen2.5vl:7b

# Option C - Anthropic Claude
# OCT_VLM_PROVIDER=anthropic
# OCT_VLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Generic key (overrides the provider-specific ones above when set)
# OCT_VLM_API_KEY=
OCT_VLM_TIMEOUT=120
OCT_VLM_MAX_TOKENS=1500

# --- data ---------------------------------------------------------------------------------------------------------
# Default: the 73-image full-history subset committed in the repository (dev eyes 25, 11, 61 have OCT images).
# After running phase2/run_gpu_pipeline.sh (4,685 scans, 55 train eyes):
# OCT_SUBSET=phase2/data/scan_subset_v1
# OCT_EMBEDDINGS=phase2/results/scan_subset_v1/resnet50/embeddings.npz
OCT_SUBSET=phase2/data/atlas_fullhist
OCT_EMBEDDINGS=phase2/results/fullhist/resnet50/embeddings.npz
OCT_VISIT_MODE=central
# Eyes offered in the UI; the protocol's held-out (val) and test eyes stay out by default.
OCT_SPLITS=train
# 1 = embed uploaded scans with ResNet-50 (downloads ImageNet weights once, about 100 MB) for "most similar visit"
OCT_UPLOAD_EMBEDDING=1
OCT_UPLOAD_MAX_MB=10
